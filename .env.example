# Supabase Project Configuration Example
# Copy this file to .env and fill in your actual Supabase details.

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-publishable-anon-key

# Service Role Key is ONLY used for local python script migration (migrate_to_supabase.py)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin User ID (Auth User UUID) for UI routing checks in /admin/
ADMIN_UID=your-admin-user-uuid
